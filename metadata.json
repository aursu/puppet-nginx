{
  "name": "aursu-nginx",
  "version": "4.4.2",
  "author": "Vox Pupuli",
  "summary": "Puppet NGINX management module",
  "license": "MIT",
  "source": "https://github.com/aursu/puppet-nginx.git",
  "project_page": "http://github.com/aursu/puppet-nginx",
  "issues_url": "https://github.com/aursu/puppet-nginx/issues",
  "dependencies": [
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 4.1.0 < 10.0.0"
    },
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 5.0.0 < 10.0.0"
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8"
      ]
    },
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [
        "7"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "18.04",
        "20.04",
        "22.04"
      ]
    }
  ]
}
