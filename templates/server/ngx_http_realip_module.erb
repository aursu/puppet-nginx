<%-
def bool2config(b)
    case b
    when true
        'on'
    when false, nil
        'off'
    else
        b.to_s
    end
end
-%>
<%- if @set_real_ip_from -%>
  <%- Array(@set_real_ip_from).each do |addr| -%>
  set_real_ip_from <%= addr %>;
  <%- end -%>
<%- end -%>
<%- if @real_ip_header -%>
  real_ip_header <%= @real_ip_header %>;
<%- end -%>
<% unless @real_ip_recursive.nil? -%>
  real_ip_recursive <%= bool2config(@real_ip_recursive) %>;
<% end -%>